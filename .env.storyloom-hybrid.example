# Use case 1 — everything on one machine, with hybrid inference.
#
# The language model runs on OpenRouter while speech, alignment and images stay on this
# machine. The database is a local SQLite file and artifacts go to disk, so only Redis
# has to be running:
#   docker compose -f docker-compose.dev.yml up -d
#   pnpm db:migrate && pnpm dev:hybrid

STORYLOOM_MODE=hybrid
STORYLOOM_PUBLIC_URL=http://localhost:4173
STORYLOOM_TECHNICAL_UI=false

# A plain file. Only one machine can use it, which is exactly this topology.
DATABASE_URL=file:./data/hybrid/storyloom.db
REDIS_URL=redis://127.0.0.1:6379
STORYLOOM_QUEUE_PREFIX=storyloom-hybrid

# openssl rand -base64 32
STORYLOOM_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

STORAGE_DRIVER=fs
STORYLOOM_DATA_DIR=./data/hybrid

# One process serves the app and drains the queue. Local media models load one phase at
# a time, so one job at a time.
STORYLOOM_WORKER_MODE=inline
STORYLOOM_WORKER_CONCURRENCY=1

# dev:hybrid and build:hybrid securely reuse OPENROUTER_API_KEY from
# .env.storyloom-cloud unless it is already present in the process environment.
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash-0731

LOCAL_TTS_BASE_URL=http://127.0.0.1:7861/v1
LOCAL_TTS_ENGINE=chatterbox-v3
LOCAL_TTS_MODEL=tts-1-it
LOCAL_TTS_RUNTIME_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
LOCAL_IMAGE_BASE_URL=http://127.0.0.1:7862/v1
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
LOCAL_IMAGE_RUNTIME_MODEL=mlx-community/flux2-klein-4b-4bit
LOCAL_ALIGNER_BASE_URL=http://127.0.0.1:7863/v1

TEXT_POLICY=cloud-only
TTS_POLICY=local-required
IMAGE_POLICY=local-required
ALIGNMENT_POLICY=local-required
