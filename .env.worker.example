# Base `.env` for a remote inference machine. It contains shared infrastructure and
# credentials only; pair it with `.env.storyloom-hybrid` or another profile overlay.
#
#   cp .env.worker.example .env
#   cp .env.storyloom-hybrid.example .env.storyloom-hybrid
#   pnpm worker:hybrid

DATABASE_URL=libsql://storyloom-<org>.turso.io
DATABASE_AUTH_TOKEN=
REDIS_URL=rediss://default:password@your-redis-host:6379
STORYLOOM_QUEUE_PREFIX=storyloom

# Must match the web deployment so this worker can decrypt account provider keys.
STORYLOOM_ENCRYPTION_KEY=
OPENROUTER_API_KEY=

STORAGE_DRIVER=s3
S3_BUCKET=storyloom-artifacts
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STORYLOOM_WORKER_MODE=external
STORYLOOM_WORKER_LOCK_MS=600000
STORYLOOM_WORKER_STALLED_MS=60000
