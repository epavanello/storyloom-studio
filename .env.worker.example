# Use case 3 — deployed app, inference on your own hardware.
#
# The web app runs on a cheap box with STORYLOOM_WORKER_MODE=off, so it only accepts
# and reports jobs. This machine drains the queue with its own models and writes the
# results to the same Turso database and the same bucket, so the deployed app serves
# media this machine produced.
#
#   pnpm worker            # after `set -a && . ./.env.worker && set +a`
#   node --env-file=.env.worker node_modules/.bin/tsx src/worker.ts
#
# The database, Redis, bucket and queue prefix must match the web deployment exactly.
# A file: database will NOT work here: two machines cannot share a SQLite file.

STORYLOOM_MODE=hybrid

DATABASE_URL=libsql://storyloom-<org>.turso.io
DATABASE_AUTH_TOKEN=
REDIS_URL=rediss://default:password@your-redis-host:6379
STORYLOOM_QUEUE_PREFIX=storyloom
# Must be the same value as the web deployment, or stored provider keys are unreadable.
STORYLOOM_ENCRYPTION_KEY=

# The same bucket the web app reads from.
STORAGE_DRIVER=s3
S3_BUCKET=storyloom-artifacts
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# A local chapter render holds a job for a long time.
STORYLOOM_WORKER_CONCURRENCY=1
STORYLOOM_WORKER_LOCK_MS=600000

OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash-0731

LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=storyloom-text
LOCAL_LLM_MODEL_KEY=qwen/qwen3.6-35b-a3b
LOCAL_TTS_ENGINE=qwen
LOCAL_TTS_BASE_URL=http://127.0.0.1:7861/v1
LOCAL_TTS_MODEL=tts-1-it
LOCAL_TTS_RUNTIME_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
LOCAL_IMAGE_BASE_URL=http://127.0.0.1:7862/v1
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
LOCAL_IMAGE_RUNTIME_MODEL=mlx-community/flux2-klein-4b-4bit
LOCAL_ALIGNER_BASE_URL=http://127.0.0.1:7863/v1

TEXT_POLICY=cloud-only
TTS_POLICY=local-required
IMAGE_POLICY=local-required
ALIGNMENT_POLICY=local-required
