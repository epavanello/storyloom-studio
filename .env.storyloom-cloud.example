# Use case 2 — full SaaS.
#
# One small always-on box serving the app and draining its own queue, Turso for the
# database, Cloudflare R2 for artifacts, and all inference through OpenRouter with
# each account's own key. No second machine is involved.

STORYLOOM_MODE=cloud
STORYLOOM_PUBLIC_URL=https://storyloom.example.com
STORYLOOM_TECHNICAL_UI=false

# Hosted SQLite, reachable from anywhere.
DATABASE_URL=libsql://storyloom-<org>.turso.io
DATABASE_AUTH_TOKEN=
REDIS_URL=rediss://default:password@your-redis-host:6379
STORYLOOM_QUEUE_PREFIX=storyloom

# openssl rand -base64 32 (both, and keep them out of source control)
STORYLOOM_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
STORYLOOM_ALLOW_SIGNUP=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
STORAGE_DRIVER=s3
S3_BUCKET=storyloom-artifacts
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# One box does both jobs: it serves the app and drains the queue.
STORYLOOM_WORKER_MODE=inline
STORYLOOM_WORKER_CONCURRENCY=2

# Left empty on purpose: every account brings its own key under Settings.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

TEXT_POLICY=cloud-only
TTS_POLICY=cloud-only
IMAGE_POLICY=cloud-only
ALIGNMENT_POLICY=cloud-only
