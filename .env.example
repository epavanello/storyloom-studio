# Base deployment configuration.
#
# Copy this file to `.env` once. It owns infrastructure, credentials, storage and
# account settings shared by every inference profile. Then copy one profile overlay:
#   .env.storyloom-local.example  -> .env.storyloom-local
#   .env.storyloom-hybrid.example -> .env.storyloom-hybrid
#   .env.storyloom-cloud.example  -> .env.storyloom-cloud
#
# Vite and the profile-specific worker commands load `.env` first, then the selected
# overlay. Variables explicitly exported by the process always retain priority.

# --- Public application and shared state -------------------------------------
STORYLOOM_PUBLIC_URL=http://localhost:4173
STORYLOOM_TECHNICAL_UI=false

# Local single-machine default. For a distributed deployment replace this with a
# libsql:// Turso URL and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/storyloom.db
DATABASE_AUTH_TOKEN=
# Leave empty for the durable in-process queue on one machine. A detached worker needs
# a shared Redis URL instead.
REDIS_URL=
STORYLOOM_QUEUE_PREFIX=storyloom

# --- Secrets and accounts ----------------------------------------------------
# Generate both with: openssl rand -base64 32
STORYLOOM_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
# Open registration. Off by default: set to true only while creating accounts, then
# put it back. It gates email/password sign-up and OAuth first-time sign-in alike.
STORYLOOM_ALLOW_SIGNUP=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Operator fallback only. On a public deployment, leave this empty and let each
# account save its own OpenRouter key under Settings.
OPENROUTER_API_KEY=

# How OpenRouter picks between the providers serving a model: throughput, latency,
# price, or empty for its default price-weighted load balancing. Any value here
# disables that balancing. Requests always demand providers that honour a strict
# json_schema, whatever this is set to; empty it if routing finds no candidate.
OPENROUTER_PROVIDER_SORT=throughput

# --- Artifact storage --------------------------------------------------------
# Local single-machine default. For S3/R2 use STORAGE_DRIVER=s3 and fill the fields.
STORAGE_DRIVER=fs
STORYLOOM_DATA_DIR=./data
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# --- Queue consumer topology -------------------------------------------------
# inline | external | off. `inline` works with the in-process queue; external/off
# requires REDIS_URL so another process can see and drain the same queue.
STORYLOOM_WORKER_MODE=inline
STORYLOOM_WORKER_LOCK_MS=120000
STORYLOOM_WORKER_STALLED_MS=60000
