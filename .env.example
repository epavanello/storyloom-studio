# Complete reference of every setting. Copy the profile you need instead of this file:
#   .env.storyloom-hybrid.example → 1. one machine: cloud language model, local media
#   .env.storyloom-local.example  →    one machine, nothing leaves it
#   .env.storyloom-cloud.example  → 2. full SaaS, cloud inference
#   .env.worker.example           → 3. deployed app, inference on your own hardware

# --- Runtime -----------------------------------------------------------------
# mock | local | cloud | hybrid — what this process is able to execute.
STORYLOOM_MODE=mock
# Public origin of the web app. Used for auth callbacks and cookies.
STORYLOOM_PUBLIC_URL=http://localhost:4173

# --- Shared state ------------------------------------------------------------
# SQLite through libSQL. Both the web tier and every worker point at the same one.
#   file:./data/storyloom.db      a local file; only one machine can use it
#   libsql://<db>.turso.io        hosted, required when the worker runs elsewhere
DATABASE_URL=file:./data/storyloom.db
# Required for a libsql:// URL, unused for file:.
DATABASE_AUTH_TOKEN=
# Redis carries the job queue and live job progress.
REDIS_URL=redis://127.0.0.1:6379
# Namespaces every Redis key. Two deployments, or a dev server and a test run,
# can share one Redis instance without draining each other's queues.
STORYLOOM_QUEUE_PREFIX=storyloom
# Encrypts stored provider keys. Generate with: openssl rand -base64 32
# Changing it makes every stored key unreadable.
STORYLOOM_ENCRYPTION_KEY=

# --- Sessions ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Extra origins allowed to complete an auth flow, comma separated.
BETTER_AUTH_TRUSTED_ORIGINS=
# Set to false to close registration on this deployment.
STORYLOOM_ALLOW_SIGNUP=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Artifact storage --------------------------------------------------------
# fs | s3. Defaults to s3 when S3_BUCKET is set.
STORAGE_DRIVER=fs
# Only used by the fs driver.
STORYLOOM_DATA_DIR=./data
# S3-compatible object storage. For Cloudflare R2 the endpoint is
# https://<account-id>.r2.cloudflarestorage.com and the region is auto.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Lifetime of the signed URL handed to a browser after an ownership check.
S3_SIGNED_URL_TTL_SECONDS=900

# --- Worker ------------------------------------------------------------------
# inline runs the queue consumer inside the web process; external expects a
# separate `pnpm worker`, possibly on another machine; off disables job execution
# in this process entirely.
STORYLOOM_WORKER_MODE=inline
STORYLOOM_WORKER_CONCURRENCY=2
# A heavy step can hold the lock for minutes; raise these before lowering them.
STORYLOOM_WORKER_LOCK_MS=120000
STORYLOOM_WORKER_STALLED_MS=60000

# --- Inference: local OpenAI-compatible endpoints -----------------------------
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=storyloom-text
LOCAL_LLM_MODEL_KEY=qwen/qwen3.6-35b-a3b
# qwen | chatterbox-v3
LOCAL_TTS_ENGINE=qwen
LOCAL_TTS_BASE_URL=http://127.0.0.1:7861/v1
LOCAL_TTS_ENGINE=qwen
LOCAL_TTS_MODEL=tts-1-it
LOCAL_TTS_RUNTIME_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
LOCAL_IMAGE_BASE_URL=http://127.0.0.1:7862/v1
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
LOCAL_IMAGE_RUNTIME_MODEL=mlx-community/flux2-klein-4b-4bit
LOCAL_ALIGNER_BASE_URL=http://127.0.0.1:7863/v1

# --- Inference: cloud ---------------------------------------------------------
# Operator fallback key, used only when the account running the job has none of
# its own. Leave empty on a public deployment where everyone brings their key.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Capability policies ------------------------------------------------------
# local-required | local-preferred | cloud-preferred | cloud-only
TEXT_POLICY=local-preferred
TTS_POLICY=local-preferred
IMAGE_POLICY=local-preferred
ALIGNMENT_POLICY=local-preferred
