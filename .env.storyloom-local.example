# Everything on one machine, including the language model.
#
# The app, a local SQLite file, artifacts on disk, and every capability served by this
# machine's own runtimes. Only Redis has to be running:
#   docker compose -f docker-compose.dev.yml up -d
#   pnpm db:migrate && pnpm dev:local
#
# For the more common shape — language model on OpenRouter, speech and images local —
# use .env.storyloom-hybrid.example instead.

STORYLOOM_MODE=local
STORYLOOM_PUBLIC_URL=http://localhost:4173
STORYLOOM_TECHNICAL_UI=true

# A plain file. Only one machine can use it, which is exactly this topology.
DATABASE_URL=file:./data/storyloom.db
REDIS_URL=redis://127.0.0.1:6379
STORYLOOM_QUEUE_PREFIX=storyloom

# openssl rand -base64 32
STORYLOOM_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

STORAGE_DRIVER=fs
STORYLOOM_DATA_DIR=./data

# One process serves the app and drains the queue.
STORYLOOM_WORKER_MODE=inline
# Heavy models are loaded one phase at a time, so one job at a time.
STORYLOOM_WORKER_CONCURRENCY=1

LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=storyloom-text
LOCAL_LLM_MODEL_KEY=qwen/qwen3.6-35b-a3b
LOCAL_TTS_ENGINE=qwen
LOCAL_TTS_BASE_URL=http://127.0.0.1:7861/v1
LOCAL_TTS_MODEL=tts-1-it
LOCAL_TTS_RUNTIME_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
LOCAL_IMAGE_BASE_URL=http://127.0.0.1:7862/v1
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
LOCAL_IMAGE_RUNTIME_MODEL=mlx-community/flux2-klein-4b-4bit
LOCAL_ALIGNER_BASE_URL=http://127.0.0.1:7863/v1

TEXT_POLICY=local-required
TTS_POLICY=local-required
IMAGE_POLICY=local-required
ALIGNMENT_POLICY=local-required
